# === Storage ===
# SQLite par defaut (zero config). Postgres : postgresql+asyncpg://user:pass@postgres:5432/surebet
DATABASE_URL=sqlite+aiosqlite:///./surebet.db

# === IA (provider-agnostique) ===
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LLM_HOURLY_CALL_BUDGET=200
AI_NORMALIZER_CONFIDENCE_THRESHOLD=0.9

# === Notifier Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Seuils d'alerte (spec MISSION §8) ===
MIN_ROI_ALERT_PCT=3.0
MIN_SCORE_ALERT=70
DEFAULT_BANKROLL=50000

# === Scraping (spec MISSION §3) ===
SCRAPE_INTERVAL_PREMATCH_S=30
SCRAPE_INTERVAL_LIVE_S=10
ODDS_MAX_AGE_S=60
SCRAPER_UNAVAILABLE_ALERT_AFTER_S=300

# === Normalizer ===
FUZZY_TEAM_THRESHOLD=85

# === Collector (sessions navigateur persistantes) ===
# false recommande en PROD : en headless, Cloudflare bloque les feeds (403).
# Sous Linux sans ecran : xvfb-run -a python -m surebet.main --collector
BROWSER_HEADLESS=true
BROWSER_PROFILE_DIR=./.browser-profiles
EVALUATION_INTERVAL_S=10

# === Dashboard ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# === Bookmakers ===
XBET_BASE_URL=https://ht.1xbet.com
PARYAJLAKAY_BASE_URL=https://www.paryajlakay.com
PARYAJPAM_BASE_URL=https://www.paryajpam.com
GOLCASH_BASE_URL=https://www.golcashhaiti.com
